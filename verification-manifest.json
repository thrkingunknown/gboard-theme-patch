{
  "name": "Gboard AMOLED Theme Studio",
  "version": "1.0.0",
  "package": "com.google.android.inputmethod.latin",
  "supportedVersion": "Any",
  "defaultTheme": {
    "name": "Midnight Red",
    "background": "#000000",
    "primary": "#FF0000",
    "secondary": "#2A0A0A",
    "tertiary": "#1F0B0B"
  },
  "additionalThemes": {
    "enabled": true,
    "format": "Name|Background|Primary|Secondary|Tertiary",
    "separator": ";;",
    "acceptedSeparators": [
      ";;",
      ";",
      "\n"
    ],
    "emptyValue": "(none)",
    "invalidEntries": "ignored"
  },
  "metadata": {
    "repository": "https://github.com/thrkingunknown/gboard-theme-patch",
    "rawUrl": "https://raw.githubusercontent.com/thrkingunknown/gboard-theme-patch/main/patches-bundle.json",
    "managerSourceUrl": "https://github.com/thrkingunknown/gboard-theme-patch",
    "format": "Morphe patches-bundle.json"
  }
}
