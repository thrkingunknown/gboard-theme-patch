{
  "name": "Gboard AMOLED Theme Studio",
  "version": "1.0.3",
  "package": "com.google.android.inputmethod.latin",
  "supportedVersion": "Any",
  "defaultTheme": {
    "name": "Midnight Red",
    "background": "#000000",
    "primary": "#FF0000",
    "secondary": "#2A0A0A",
    "tertiary": "#1F0B0B"
  },
  "additionalThemes": {
    "enabled": true,
    "format": "Name|Background|Primary|Secondary|Tertiary",
    "separator": ";;",
    "emptyValue": "(none)"
  },
  "runtimeSafety": {
    "contextLookup": "reflection on ThemeListingFragment.getContext()",
    "avoidsDirectAndroidxFragmentInvoke": true
  },
  "checks": {
    "morpheComposites": "scripts/verify_morphe_composites.py"
  }
}
